{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../site/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../site/src/lib/conversation-flow/**/*.ts"
  ]
}
