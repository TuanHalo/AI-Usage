  "cards": [
    {
      "dot": "violet",
      "title": "Why Hybrid (RSA + AES)?",
      "items": [
        "RSA cannot hold large payloads and has no secret in the browser, so FE encrypts data with a one-time AES key",
        "RSA-OAEP-256 safely wraps only that 32-byte AES key using the server's public key",
        "Only the KMS/HSM private key can unwrap the AES key — never the browser or edge proxy"
      ]
    },
    {
      "dot": "rose",
      "title": "Tamper Proof (AES-256-GCM)",
      "items": [
        "Every request uses a fresh random 12-byte IV (Nonce) so identical cards look totally different",
        "AES-GCM generates a 16-byte Auth Tag alongside the ciphertext",
        "Flipping even 1 bit in transit makes tag verification fail immediately on the backend"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zero-Trust Hygiene",
      "items": [
        "Edge proxies and API request logs only ever observe an opaque 5-part JWE string",
        "Key ID (kid) in the JWE header lets KMS rotate keys smoothly without downtime",
        "Plaintext card buffers are wiped right after PSP tokenization — never saved to DB or logs"
      ]
    }
  ]
}
