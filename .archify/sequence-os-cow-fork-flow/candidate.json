    {
      "dot": "cyan",
      "title": "Why fork() Is Fast",
      "items": [
        "fork() only duplicates page table entries, not gigabytes of RAM",
        "Both processes initially share Frame #42 marked Read-Only"
      ]
    },
    {
      "dot": "rose",
      "title": "Write Triggers Protection Fault",
      "items": [
        "Writing to a Read-Only COW page raises a hardware page fault",
        "Kernel copies just that 4KB page into Frame #99 as Read-Write"
      ]
    },
    {
      "dot": "amber",
      "title": "Production Redis Trap",
      "items": [
        "Redis BGSAVE forks; heavy writes during snapshot copy pages",
        "Up to 2x RAM can be used if every page is dirtied mid-save"
      ]
    }
