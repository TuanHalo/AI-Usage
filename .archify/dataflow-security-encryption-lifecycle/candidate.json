  "cards": [
    {
      "dot": "cyan",
      "title": "1. Data in Transit (TLS + JWE)",
      "items": [
        "TLS 1.3 stops Wi-Fi sniffers between Browser and Edge",
        "App-layer JWE keeps card data locked past Load Balancers and Proxies",
        "Logs and APM tools never see raw card numbers or CVV"
      ]
    },
    {
      "dot": "rose",
      "title": "2. Data at Rest (Envelope + KMS)",
      "items": [
        "A fast Data Encryption Key (DEK) encrypts stored records with AES-256-GCM",
        "A KMS Master Key (KEK) wraps the DEK and rotates on schedule",
        "Raw CVV is never stored after authorization under PCI DSS"
      ]
    },
    {
      "dot": "emerald",
      "title": "3. Why Passwords Hash, Cards Encrypt",
      "items": [
        "Passwords use one-way salted Argon2id hashing — the server never needs the original text",
        "Card payments require reversible encryption or tokenization so a PSP can charge them",
        "Secrets and private keys stay in KMS/Vault, never inside frontend JavaScript"
      ]
    }
  ]
}
