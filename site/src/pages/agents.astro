---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import ClayButton from '../components/ClayButton.astro';
import T from '../components/T.astro';
import agentsData from '../data/agents.json';

interface AgentItem {
  name: string;
  version: string;
  role: string;
  description: string;
  capabilities: string[];
  skills: string[];
  rules: string[];
  tags: string[];
}

const agents: AgentItem[] = agentsData;
---

<BaseLayout titleKey="meta.agents.title">
  <div style="margin-bottom: 32px;">
    <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 900; margin-bottom: 8px;">
      <T k="catalog.agents.title" />
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-secondary);">
      <T k="catalog.agents.subtitle" />
    </p>
  </div>

  {agents.length === 0 ? (
    <ClayCard variant="agents" style="text-align: center; padding: 48px 24px;">
      <span style="font-size: 3rem; display: block; margin-bottom: 12px;">🌱</span>
      <h3 style="font-family: var(--font-display); font-size: 1.5rem; margin-bottom: 8px;">
        <T k="catalog.agents.emptyTitle" />
      </h3>
      <p style="color: var(--color-text-secondary); max-width: 520px; margin: 0 auto 24px;">
        <T k="catalog.agents.emptyDesc" html={true} />
      </p>
      <ClayButton href="https://github.com/TuanHalo/AI-Usage">
        <T k="catalog.agents.emptyCta" />
      </ClayButton>
    </ClayCard>
  ) : (
    <div style="display: flex; flex-direction: column; gap: 32px;">
      {agents.map((agent) => (
        <ClayCard variant="agents">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
            <div>
              <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
                <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800;">
                  {agent.name}
                </h2>
                <ClayBadge>v{agent.version}</ClayBadge>
                <ClayBadge style="background: var(--color-surface); color: var(--status-success-fg);">{agent.role}</ClayBadge>
              </div>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                {agent.tags.map((tag) => (
                  <ClayBadge style="background: var(--color-surface-soft); font-size: 0.78rem;">
                    #{tag}
                  </ClayBadge>
                ))}
              </div>
            </div>

            <ClayButton href={`https://github.com/TuanHalo/AI-Usage/tree/main/assets/agents/${agent.name}.yaml`}>
              <T k="catalog.sourceYaml" />
            </ClayButton>
          </div>

          <p style="font-size: 1.05rem; margin-bottom: 20px;">
            {agent.description}
          </p>

          <div style="background: var(--color-surface-soft); border-radius: var(--clay-radius-md); padding: 20px;">
            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 10px;">
              <T k="catalog.agents.capabilitiesLabel" />
            </h3>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
              {agent.capabilities.map((cap) => (
                <ClayBadge style="background: var(--color-surface); font-family: var(--font-mono); font-size: 0.85rem;">
                  {cap}
                </ClayBadge>
              ))}
            </div>

            <div style="display: flex; gap: 24px; flex-wrap: wrap;">
              <div>
                <span style="font-weight: 700; font-size: 0.9rem;"><T k="catalog.agents.skillsBound" /></span>
                {agent.skills.join(', ')}
              </div>
              <div>
                <span style="font-weight: 700; font-size: 0.9rem;"><T k="catalog.agents.rulesEnforced" /></span>
                {agent.rules.join(', ')}
              </div>
            </div>
          </div>
        </ClayCard>
      ))}
    </div>
  )}
</BaseLayout>
