---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import ClayButton from '../components/ClayButton.astro';

const agents = [
  {
    name: 'research-analyst',
    version: '1.0.0',
    role: 'Technical Research Analyst',
    description: 'Autonomous research agent tasked with deep investigations, architecture evaluations, and compiling rich HTML research outputs.',
    capabilities: ['web_search', 'file_read', 'file_write', 'html_generation'],
    skills: ['deep-research'],
    rules: ['typescript-standards'],
    tags: ['agent', 'research', 'evaluation']
  }
];
---

<BaseLayout title="Agents Catalog — AI-Usage">
  <div style="margin-bottom: 32px;">
    <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 900; margin-bottom: 8px;">
      🤖 Agents Catalog
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-secondary);">
      Specialized autonomous agent personas, tool boundaries, and role definitions.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 32px;">
    {agents.map((agent) => (
      <ClayCard variant="agents">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
          <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
              <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800;">
                {agent.name}
              </h2>
              <ClayBadge>v{agent.version}</ClayBadge>
              <ClayBadge style="background: #ffffff; color: #0d9488;">{agent.role}</ClayBadge>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              {agent.tags.map((tag) => (
                <ClayBadge style="background: rgba(255,255,255,0.65); font-size: 0.78rem;">
                  #{tag}
                </ClayBadge>
              ))}
            </div>
          </div>

          <ClayButton href="https://github.com/TuanHalo/AI-Usage/tree/main/assets/agents/research-analyst.yaml">
            Source YAML ➔
          </ClayButton>
        </div>

        <p style="font-size: 1.05rem; margin-bottom: 20px;">
          {agent.description}
        </p>

        <div style="background: rgba(255, 255, 255, 0.7); border-radius: var(--clay-radius-md); padding: 20px;">
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 10px;">Capabilities</h3>
          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
            {agent.capabilities.map((cap) => (
              <ClayBadge style="background: #ffffff; font-family: var(--font-mono); font-size: 0.85rem;">
                {cap}
              </ClayBadge>
            ))}
          </div>

          <div style="display: flex; gap: 24px; flex-wrap: wrap;">
            <div>
              <span style="font-weight: 700; font-size: 0.9rem;">Skills Bound: </span>
              {agent.skills.join(', ')}
            </div>
            <div>
              <span style="font-weight: 700; font-size: 0.9rem;">Rules Enforced: </span>
              {agent.rules.join(', ')}
            </div>
          </div>
        </div>
      </ClayCard>
    ))}
  </div>
</BaseLayout>
