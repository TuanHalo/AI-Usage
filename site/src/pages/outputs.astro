---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import ClayButton from '../components/ClayButton.astro';

interface OutputQuickLink {
  readonly label: string;
  readonly href: string;
}

interface OutputDeliverable {
  readonly title: string;
  readonly date: string;
  readonly category: string;
  readonly agent: string;
  readonly status: string;
  readonly summary: string;
  readonly tags: readonly string[];
  readonly htmlPath: string;
  readonly quickLinks?: readonly OutputQuickLink[];
}

const outputs: readonly OutputDeliverable[] = [
  {
    title: 'OS Interview Mastery Series — CS Learning Hub',
    date: '2026-11-14',
    category: 'CS Learning Hub',
    agent: 'cs-mentor',
    status: 'Published',
    summary: 'Complete 6-module Operating Systems interview curriculum with daily-life analogies, Fresher-to-Senior level tags, interactive labs, flashcards, and 6 animated Archify flow diagrams.',
    tags: ['operating-systems', 'interview-prep', 'archify', 'fresher-to-senior'],
    htmlPath: `${import.meta.env.BASE_URL}outputs/learning/os-interview/index.html`,
    quickLinks: [
      {
        label: '📘 M1: Process & Thread',
        href: `${import.meta.env.BASE_URL}outputs/learning/os-interview/module-1-process-thread.html`
      },
      {
        label: '🔀 M2: Context Switch & COW',
        href: `${import.meta.env.BASE_URL}outputs/learning/os-interview/module-2-context-switch-ipc.html`
      },
      {
        label: '🧠 M3: Virtual Memory',
        href: `${import.meta.env.BASE_URL}outputs/learning/os-interview/module-3-virtual-memory.html`
      },
      {
        label: '🔒 M4: Locks & Deadlock',
        href: `${import.meta.env.BASE_URL}outputs/learning/os-interview/module-4-concurrency-locking.html`
      },
      {
        label: '⚡ M5: Syscalls & epoll',
        href: `${import.meta.env.BASE_URL}outputs/learning/os-interview/module-5-kernel-io-filesystems.html`
      },
      {
        label: '🎯 M6: Flashcards & Cheat Sheet',
        href: `${import.meta.env.BASE_URL}outputs/learning/os-interview/module-6-interview-drill.html`
      }
    ]
  },
  {
    title: 'Autonomous AI Agent Architectures — 2026 Evaluation',
    date: '2026-11-09',
    category: 'Research Report',
    agent: 'research-analyst',
    status: 'Published',
    summary: 'Comprehensive comparative evaluation of hierarchical vs peer agent orchestration architectures, topological flow, and token budget impacts.',
    tags: ['agents', 'architecture', 'multi-agent', 'orchestration'],
    htmlPath: `${import.meta.env.BASE_URL}outputs/research/ai-agent-architectures/index.html`
  }
];
---

<BaseLayout title="AI Outputs & Research — AI-Usage">
  <div style="margin-bottom: 32px;">
    <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 900; margin-bottom: 8px;">
      📊 AI Deliverables & Research Outputs
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-secondary);">
      Rich HTML research deliverables, system architecture evaluations, and interactive graphs generated by AI agents.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 40px;">
    {outputs.map((out) => (
      <ClayCard variant="outputs">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
          <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
              <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800;">
                {out.title}
              </h2>
              <ClayBadge style="background: #ffffff; color: #e11d48;">{out.status}</ClayBadge>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <ClayBadge style="background: rgba(255,255,255,0.7); font-size: 0.85rem;">
                📅 {out.date}
              </ClayBadge>
              <ClayBadge style="background: rgba(255,255,255,0.7); font-size: 0.85rem;">
                🤖 Agent: {out.agent}
              </ClayBadge>
              {out.tags.map((tag) => (
                <ClayBadge style="background: rgba(255,255,255,0.5); font-size: 0.78rem;">
                  #{tag}
                </ClayBadge>
              ))}
            </div>
          </div>

          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <ClayButton href={out.htmlPath} class="open-btn" style="background-color: #ffffff;">
              🔗 Open Fullscreen HTML
            </ClayButton>
            {out.quickLinks && out.quickLinks.map((link) => (
              <ClayButton href={link.href} style="background-color: rgba(255,255,255,0.82); font-size: 0.9rem;">
                {link.label}
              </ClayButton>
            ))}
          </div>
        </div>

        <p style="font-size: 1.05rem; margin-bottom: 24px; color: var(--color-text-secondary);">
          {out.summary}
        </p>

        <!-- Clay Embedded Preview Box -->
        <div style="background: #ffffff; border-radius: var(--clay-radius-md); padding: 12px; box-shadow: var(--clay-shadow-sm);">
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 12px 14px; border-bottom: 1px solid rgba(0,0,0,0.05);">
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--color-text-muted);">
              LIVE EMBEDDED REPORT PREVIEW (CLAY CONTAINER)
            </span>
            <a href={out.htmlPath} target="_blank" style="font-size: 0.85rem;">
              Open in new tab ↗
            </a>
          </div>
          <iframe 
            src={out.htmlPath} 
            title={out.title}
            style="width: 100%; height: 580px; border: none; border-radius: 12px; margin-top: 10px;"
          />
        </div>
      </ClayCard>
    ))}
  </div>
</BaseLayout>

