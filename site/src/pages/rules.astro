---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import ClayButton from '../components/ClayButton.astro';

const rules = [
  {
    name: 'typescript-standards',
    version: '1.0.0',
    scope: 'global',
    priority: 'high',
    description: 'Enforces strict TypeScript standards, explicit type declarations, and safety guards across all TypeScript projects. Apply whenever writing or refactoring TypeScript code.',
    tags: ['typescript', 'quality', 'safety', 'standards'],
    guidelines: [
      'No Implicit Any: Always maintain strict: true in tsconfig.',
      'Interfaces for Models: Prefer interface for entity data shapes, reserving type for unions/intersections.',
      'Explicit Return Types: All exported functions and methods must declare explicit return types.',
      'Unknown Over Any: When type is dynamic or external, use unknown with type narrowing or Zod.',
      'Immutability: Use readonly for array properties and immutable configs where appropriate.'
    ]
  }
];
---

<BaseLayout title="Rules Catalog — AI-Usage">
  <div style="margin-bottom: 32px;">
    <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 900; margin-bottom: 8px;">
      🛡️ Rules Catalog
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-secondary);">
      Persistent behavioral constraints, code conventions, and safety standards.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 32px;">
    {rules.map((rule) => (
      <ClayCard variant="rules">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
          <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
              <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800;">
                {rule.name}
              </h2>
              <ClayBadge>v{rule.version}</ClayBadge>
              <ClayBadge style="background: #ffffff; color: #0284c7;">Priority: {rule.priority}</ClayBadge>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              {rule.tags.map((tag) => (
                <ClayBadge style="background: rgba(255,255,255,0.65); font-size: 0.78rem;">
                  #{tag}
                </ClayBadge>
              ))}
            </div>
          </div>

          <ClayButton href="https://github.com/TuanHalo/AI-Usage/tree/main/assets/rules/typescript-standards.yaml">
            Source YAML ➔
          </ClayButton>
        </div>

        <p style="font-size: 1.05rem; margin-bottom: 20px;">
          {rule.description}
        </p>

        <div style="background: rgba(255, 255, 255, 0.7); border-radius: var(--clay-radius-md); padding: 20px;">
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 12px;">
            Mandatory Standards
          </h3>
          <ul style="margin-left: 20px; display: flex; flex-direction: column; gap: 8px;">
            {rule.guidelines.map((g) => (
              <li style="color: var(--color-text-secondary);">{g}</li>
            ))}
          </ul>
        </div>
      </ClayCard>
    ))}
  </div>
</BaseLayout>
