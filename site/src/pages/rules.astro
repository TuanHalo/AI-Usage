---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import ClayButton from '../components/ClayButton.astro';
import T from '../components/T.astro';
import { RULES_VI } from '../i18n/assets-vi';
import rulesData from '../data/rules.json';

interface RuleItem {
  name: string;
  version: string;
  scope: string;
  priority: string;
  description: string;
  tags: string[];
  guidelines: string[];
}

const rules: RuleItem[] = rulesData;
---

<BaseLayout titleKey="meta.rules.title">
  <div style="margin-bottom: 32px;">
    <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 900; margin-bottom: 8px;">
      <T k="catalog.rules.title" />
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-secondary);">
      <T k="catalog.rules.subtitle" />
    </p>
  </div>

  {rules.length === 0 ? (
    <ClayCard variant="rules" style="text-align: center; padding: 48px 24px;">
      <span style="font-size: 3rem; display: block; margin-bottom: 12px;">🌱</span>
      <h3 style="font-family: var(--font-display); font-size: 1.5rem; margin-bottom: 8px;">
        <T k="catalog.rules.emptyTitle" />
      </h3>
      <p style="color: var(--color-text-secondary); max-width: 520px; margin: 0 auto 24px;">
        <T k="catalog.rules.emptyDesc" html={true} />
      </p>
      <ClayButton href="https://github.com/TuanHalo/AI-Usage">
        <T k="catalog.rules.emptyCta" />
      </ClayButton>
    </ClayCard>
  ) : (
    <div style="display: flex; flex-direction: column; gap: 32px;">
      {rules.map((rule) => {
        const viEntry = RULES_VI[rule.name];
        return (
          <ClayCard variant="rules">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
              <div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
                  <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800;">
                    {rule.name}
                  </h2>
                  <ClayBadge>v{rule.version}</ClayBadge>
                  <ClayBadge style="background: var(--color-surface); color: var(--status-info-fg);">
                    <T k="catalog.rules.priority" params={{ priority: rule.priority }} />
                  </ClayBadge>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  {rule.tags.map((tag) => (
                    <ClayBadge style="background: var(--color-surface-soft); font-size: 0.78rem;">
                      #{tag}
                    </ClayBadge>
                  ))}
                </div>
              </div>

              <ClayButton href={`https://github.com/TuanHalo/AI-Usage/tree/main/assets/rules/${rule.name}.yaml`}>
                <T k="catalog.sourceYaml" />
              </ClayButton>
            </div>

            <p style="font-size: 1.05rem; margin-bottom: 20px;">
              <T en={rule.description} vi={viEntry?.descriptionVi ?? rule.description} />
            </p>

            <div style="background: var(--color-surface-soft); border-radius: var(--clay-radius-md); padding: 20px;">
              <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 12px;">
                <T k="catalog.rules.standardsLabel" />
              </h3>
              <ul style="margin-left: 20px; display: flex; flex-direction: column; gap: 8px;">
                {rule.guidelines.map((g, idx) => (
                  <li style="color: var(--color-text-secondary);">
                    <T en={g} vi={viEntry?.itemsVi[idx] ?? g} />
                  </li>
                ))}
              </ul>
            </div>
          </ClayCard>
        );
      })}
    </div>
  )}
</BaseLayout>
