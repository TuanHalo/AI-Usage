---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import T from '../components/T.astro';
---

<BaseLayout
  titleKey="meta.visualizer.title"
  descriptionKey="meta.visualizer.desc"
  wide={true}
>
  <section class="viz-hero">
    <ClayCard variant="skills" class="viz-hero-card">
      <div class="viz-hero-top">
        <div>
          <div class="viz-pill-row">
            <ClayBadge class="viz-privacy-pill"><T k="viz.hero.privacy" /></ClayBadge>
            <ClayBadge class="viz-pill-soft"><T k="viz.hero.platforms" /></ClayBadge>
          </div>
          <h1 class="viz-title"><T k="viz.hero.title" /></h1>
          <p class="viz-subtitle">
            <T k="viz.hero.subtitle" html={true} />
          </p>
        </div>
      </div>

      <div class="viz-quick-actions">
        <button type="button" class="clay-btn viz-btn-primary" id="btn-demo-contract">
          <T k="viz.actions.demoContract" />
        </button>
        <button type="button" class="clay-btn" id="btn-demo-raw">
          <T k="viz.actions.demoRaw" />
        </button>
        <button type="button" class="clay-btn" id="btn-open-desktop-modal">
          <T k="viz.actions.connectDesktop" />
        </button>
        <button type="button" class="clay-btn" id="btn-open-rule-modal">
          <T k="viz.actions.getRule" />
        </button>
        <button type="button" class="clay-btn" id="btn-toggle-history">
          <T k="viz.actions.savedFlows" /> (<span id="saved-count">0</span>)
        </button>
      </div>
    </ClayCard>
  </section>

  <!-- Toast Banner -->
  <div id="viz-toast" class="viz-toast hidden" role="status" aria-live="polite"></div>

  <!-- Real-Time Desktop Sessions Bar (auto-appears when `npm run desktop:live` is running) -->
  <section id="desktop-live-bar" class="clay-card agents viz-desktop-bar hidden" aria-label="Live desktop AI sessions">
    <div class="viz-drawer-head">
      <div>
        <div class="viz-pill-row" style="margin-bottom: 6px;">
          <span class="clay-badge viz-live-dot" id="desktop-status-badge"><T k="viz.desktop.badge" /></span>
          <span class="viz-muted-sm" id="desktop-session-count">0 session(s) detected</span>
        </div>
        <h2 class="viz-h2"><T k="viz.desktop.title" /></h2>
      </div>
      <div class="viz-btn-group">
        <label class="viz-toggle-label">
          <input type="checkbox" id="chk-auto-follow" checked />
          <span><T k="viz.desktop.autoFollow" /></span>
        </label>
        <button type="button" class="clay-btn viz-btn-sm" id="btn-refresh-desktop">
          <T k="viz.desktop.refresh" />
        </button>
      </div>
    </div>
    <div id="desktop-sessions-list" class="viz-desktop-list"></div>
  </section>

  <!-- Local Saved Flows Drawer -->
  <section id="history-drawer" class="clay-card rules viz-drawer hidden" aria-label="Locally saved flows">
    <div class="viz-drawer-head">
      <div>
        <h2 class="viz-h2"><T k="viz.history.title" /></h2>
        <p class="viz-muted"><T k="viz.history.subtitle" html={true} /></p>
      </div>
      <div class="viz-btn-group">
        <button type="button" class="clay-btn viz-btn-sm viz-btn-danger" id="btn-clear-history">
          <T k="viz.history.clearAll" />
        </button>
        <button type="button" class="clay-btn viz-btn-sm" id="btn-close-history">
          <T k="viz.common.close" />
        </button>
      </div>
    </div>
    <div id="history-list" class="viz-history-list"></div>
  </section>

  <!-- Collapsible Conversation Intake Drawer -->
  <section class="clay-card viz-intake-card" id="intake-section">
    <div class="viz-intake-head">
      <div>
        <h2 class="viz-h2"><T k="viz.intake.title" /></h2>
        <p class="viz-muted">
          <T k="viz.intake.subtitle" html={true} />
        </p>
      </div>
      <button type="button" class="clay-btn viz-btn-sm" id="btn-toggle-intake">
        ▲ Collapse Input
      </button>
    </div>

    <div id="intake-body" class="viz-intake-body">
      <textarea
        id="raw-input"
        class="viz-textarea"
        rows="9"
        placeholder="Paste your conversation from Antigravity, Claude Desktop, Gemini, Grok, ChatGPT, or structured ConversationFlow JSON here..."
        aria-label="Conversation transcript or JSON input"
        data-i18n-attr="placeholder:viz.intake.placeholder;aria-label:viz.intake.ariaLabel"
      ></textarea>

      <div class="viz-intake-controls">
        <label class="viz-select-wrap">
          <span class="viz-label-inline"><T k="viz.intake.platformLabel" /></span>
          <select id="platform-select" class="viz-select">
            <option value="generic" data-i18n="viz.intake.platformAuto">Auto-Detect</option>
            <option value="antigravity">Antigravity (Gemini)</option>
            <option value="claude">Claude</option>
            <option value="gemini">Gemini</option>
            <option value="grok">Grok</option>
            <option value="chatgpt">ChatGPT</option>
          </select>
        </label>

        <div class="viz-btn-group">
          <button type="button" class="clay-btn viz-btn-primary" id="btn-visualize">
            <T k="viz.intake.visualizeBtn" />
          </button>
          <button type="button" class="clay-btn" id="btn-copy-analyzer">
            <T k="viz.intake.copyAnalyzerBtn" />
          </button>
          <button type="button" class="clay-btn" id="btn-clear-input">
            <T k="viz.intake.clearBtn" />
          </button>
        </div>
      </div>

      <div id="parse-warnings" class="viz-warnings hidden" role="status"></div>
    </div>
  </section>

  <!-- Active Flow Workspace -->
  <section id="workspace-section" class="viz-workspace hidden">
    <!-- Mission Summary & Export Bar -->
    <div class="clay-card agents viz-mission-card">
      <div class="viz-mission-top">
        <div class="viz-mission-title-wrap">
          <div class="viz-pill-row" id="flow-meta-pills"></div>
          <input
            id="flow-title-input"
            type="text"
            class="viz-title-input"
            aria-label="Conversation title"
            data-i18n-attr="aria-label:viz.mission.titleAria"
          />
        </div>
        <div class="viz-btn-group">
          <button type="button" class="clay-btn viz-btn-sm" id="btn-export-html">
            <T k="viz.mission.exportHtml" />
          </button>
          <button type="button" class="clay-btn viz-btn-sm" id="btn-copy-md">
            <T k="viz.mission.copyMd" />
          </button>
          <button type="button" class="clay-btn viz-btn-sm" id="btn-export-json">
            <T k="viz.mission.exportJson" />
          </button>
          <button type="button" class="clay-btn viz-btn-sm viz-btn-primary" id="btn-save-local">
            <T k="viz.mission.saveLocal" />
          </button>
        </div>
      </div>

      <div class="viz-mission-grid">
        <div class="viz-mission-box">
          <label class="viz-sub-label" for="overall-goal-input"><T k="viz.mission.goalLabel" /></label>
          <textarea id="overall-goal-input" class="viz-inline-area" rows="2"></textarea>
        </div>
        <div class="viz-mission-box">
          <label class="viz-sub-label" for="final-outcome-input"><T k="viz.mission.outcomeLabel" /></label>
          <textarea id="final-outcome-input" class="viz-inline-area" rows="2"></textarea>
        </div>
      </div>

      <div
        class="viz-filter-row"
        id="delta-filters"
        role="group"
        aria-label="Filter turns by scope delta"
        data-i18n-attr="aria-label:viz.mission.filterAria"
      ></div>
    </div>

    <!-- Session Parking Lot (Auto-shown when off-topic tangents are parked) -->
    <section
      id="parking-lot-card"
      class="clay-card principles viz-parking-card hidden"
      aria-label="Session parking lot"
    >
      <div class="viz-drawer-head">
        <div>
          <h2 class="viz-h2"><T k="viz.parking.title" /></h2>
          <p class="viz-muted"><T k="viz.parking.subtitle" /></p>
        </div>
      </div>
      <div id="parking-lot-list" class="viz-parking-list"></div>
    </section>

    <!-- Two-Column Synchronized Stage -->
    <div class="viz-stage">
      <div class="clay-card viz-map-panel">
        <div class="viz-panel-head">
          <div>
            <h2 class="viz-h2"><T k="viz.map.title" /></h2>
            <p class="viz-muted-sm"><T k="viz.map.subtitle" /></p>
          </div>
          <button type="button" class="clay-btn viz-btn-sm" id="btn-add-turn">
            <T k="viz.map.addTurn" />
          </button>
        </div>
        <div
          id="flow-map-list"
          class="viz-flow-list"
          role="listbox"
          aria-label="Conversation turns"
          data-i18n-attr="aria-label:viz.map.listAria"
        ></div>
      </div>

      <div class="clay-card viz-inspector-panel" id="turn-inspector" aria-live="polite"></div>
    </div>
  </section>

  <!-- Rule Modal -->
  <dialog id="rule-modal" class="viz-dialog">
    <div class="clay-card rules viz-dialog-card">
      <div class="viz-drawer-head">
        <div>
          <h2 class="viz-h2"><T k="viz.ruleModal.title" /></h2>
          <p class="viz-muted">
            <T k="viz.ruleModal.desc" />
          </p>
        </div>
        <button type="button" class="clay-btn viz-btn-sm" id="btn-close-rule-modal"><T k="viz.common.close" /></button>
      </div>
      <pre id="rule-snippet-preview" class="viz-code-block"></pre>
      <div class="viz-btn-group" style="margin-top: 16px;">
        <button type="button" class="clay-btn viz-btn-primary" id="btn-copy-rule-snippet">
          <T k="viz.ruleModal.copyBtn" />
        </button>
      </div>
    </div>
  </dialog>

  <!-- Desktop Live Setup Modal -->
  <dialog id="desktop-modal" class="viz-dialog">
    <div class="clay-card principles viz-dialog-card">
      <div class="viz-drawer-head">
        <div>
          <h2 class="viz-h2"><T k="viz.desktopModal.title" /></h2>
          <p class="viz-muted">
            <T k="viz.desktopModal.desc" html={true} />
          </p>
        </div>
        <button type="button" class="clay-btn viz-btn-sm" id="btn-close-desktop-modal"><T k="viz.common.close" /></button>
      </div>

      <div class="viz-setup-section">
        <h3 class="viz-h3"><T k="viz.desktopModal.step1Title" /></h3>
        <p class="viz-muted">
          <T k="viz.desktopModal.step1Desc" html={true} />
        </p>
        <pre class="viz-code-block">cd d:\IT\AI-Usage\site
npm run desktop:live
# Then open http://127.0.0.1:4328/AI-Usage/visualizer</pre>
      </div>

      <div class="viz-setup-section">
        <h3 class="viz-h3"><T k="viz.desktopModal.step2Title" /></h3>
        <p class="viz-muted">
          <T k="viz.desktopModal.step2Desc" html={true} />
        </p>
        <pre id="claude-mcp-preview" class="viz-code-block"></pre>
        <div class="viz-btn-group" style="margin-top: 10px;">
          <button type="button" class="clay-btn viz-btn-sm viz-btn-primary" id="btn-copy-claude-mcp">
            <T k="viz.desktopModal.copyClaudeMcp" />
          </button>
          <button type="button" class="clay-btn viz-btn-sm" id="btn-copy-claude-instructions">
            <T k="viz.desktopModal.copyClaudeInst" />
          </button>
        </div>
      </div>

      <div class="viz-setup-section">
        <h3 class="viz-h3"><T k="viz.desktopModal.step3Title" html={true} /></h3>
        <p class="viz-muted">
          <T k="viz.desktopModal.step3Desc" />
        </p>
        <pre id="agy-mcp-preview" class="viz-code-block"></pre>
        <div class="viz-btn-group" style="margin-top: 10px;">
          <button type="button" class="clay-btn viz-btn-sm" id="btn-copy-agy-mcp">
            <T k="viz.desktopModal.copyAgyMcp" />
          </button>
        </div>
      </div>
    </div>
  </dialog>

  <script>
    import '../scripts/visualizer-app';
  </script>
</BaseLayout>

<style>
  .hidden {
    display: none !important;
  }

  .viz-hero {
    margin-bottom: 24px;
  }

  .viz-hero-card {
    padding: 32px;
  }

  .viz-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
  }

  .viz-privacy-pill,
  .viz-live-dot {
    background: var(--status-success-bg) !important;
    color: var(--status-success-fg) !important;
  }

  .viz-pill-soft {
    background: var(--color-surface-soft) !important;
  }

  .viz-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 10px;
  }

  .viz-subtitle {
    font-size: 1.04rem;
    color: var(--color-text-secondary);
    max-width: 820px;
  }

  .viz-quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .viz-btn-primary {
    background-color: var(--color-accent) !important;
    color: var(--color-on-accent) !important;
  }

  .viz-btn-sm {
    padding: 8px 16px !important;
    font-size: 0.88rem !important;
    border-radius: var(--clay-radius-sm) !important;
  }

  .viz-btn-danger {
    background-color: var(--status-danger-bg) !important;
    color: var(--status-danger-fg) !important;
  }

  .viz-toast {
    margin-bottom: 18px;
    padding: 14px 20px;
    border-radius: var(--clay-radius-md);
    background: var(--status-success-bg);
    color: var(--status-success-fg);
    font-weight: 700;
    box-shadow: var(--clay-shadow-sm);
  }

  .viz-desktop-bar,
  .viz-drawer {
    margin-bottom: 24px;
    padding: 22px 26px;
  }

  .viz-desktop-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 12px;
    margin-top: 14px;
  }

  .viz-toggle-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--clay-radius-sm);
    background: var(--color-surface-soft);
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    box-shadow: var(--clay-shadow-sm);
  }

  .viz-drawer-head,
  .viz-intake-head,
  .viz-mission-top,
  .viz-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 14px;
  }

  .viz-h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .viz-h3 {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .viz-setup-section {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .viz-muted {
    color: var(--color-text-secondary);
    font-size: 0.94rem;
  }

  .viz-muted-sm {
    color: var(--color-text-muted);
    font-size: 0.84rem;
  }

  .viz-btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .viz-history-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  .viz-intake-card {
    background-color: var(--color-surface);
    margin-bottom: 24px;
    padding: 24px 28px;
  }

  .viz-intake-body {
    margin-top: 16px;
  }

  .viz-textarea,
  .viz-inline-area,
  .viz-title-input,
  .viz-select {
    width: 100%;
    border: 2px solid var(--color-input-border);
    border-radius: var(--clay-radius-sm);
    background: var(--color-surface-sunken);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    padding: 14px 16px;
    box-shadow: inset 0 3px 8px var(--color-input-shadow);
    transition: var(--clay-transition);
  }

  .viz-textarea {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    resize: vertical;
  }

  .viz-textarea:focus,
  .viz-inline-area:focus,
  .viz-title-input:focus,
  .viz-select:focus {
    outline: none;
    border-color: var(--color-accent);
    background: var(--color-surface);
  }

  .viz-intake-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
  }

  .viz-select-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .viz-label-inline {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
  }

  .viz-select {
    width: auto;
    padding: 10px 14px;
    font-weight: 600;
  }

  .viz-warnings {
    margin-top: 14px;
    padding: 12px 16px;
    border-radius: var(--clay-radius-sm);
    background: var(--status-warn-bg);
    color: var(--status-warn-fg);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .viz-workspace {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .viz-mission-card {
    padding: 24px 28px;
  }

  .viz-mission-title-wrap {
    flex: 1 1 320px;
  }

  .viz-title-input {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    padding: 8px 14px;
    background: var(--color-surface-soft);
  }

  .viz-mission-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .viz-mission-box {
    background: var(--color-surface-soft);
    border-radius: var(--clay-radius-md);
    padding: 14px 16px;
  }

  .viz-sub-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  .viz-inline-area {
    padding: 10px 12px;
    font-size: 0.95rem;
    resize: vertical;
  }

  .viz-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .viz-stage {
    display: grid;
    grid-template-columns: minmax(340px, 440px) 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .viz-map-panel,
  .viz-inspector-panel {
    background-color: var(--color-surface);
    padding: 24px;
    height: 100vh;
    min-height: 720px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-scrollbar) transparent;
  }

  .viz-map-panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .viz-inspector-panel {
    overflow-y: auto;
  }

  .viz-map-panel:hover,
  .viz-inspector-panel:hover,
  .viz-intake-card:hover,
  .viz-hero-card:hover,
  .viz-mission-card:hover,
  .viz-desktop-bar:hover,
  .viz-parking-card:hover {
    transform: none;
  }

  .viz-parking-card {
    padding: 22px 26px;
  }

  .viz-parking-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 14px;
  }

  :global(.viz-parking-item) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 12px 16px;
    border-radius: var(--clay-radius-sm);
    background: var(--color-surface-soft);
    box-shadow: var(--clay-shadow-sm);
  }

  :global(.viz-parking-topic) {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .viz-flow-list {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 4px 6px 8px 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-scrollbar) transparent;
  }

  @media (max-width: 920px) {
    .viz-stage {
      grid-template-columns: 1fr;
    }

    .viz-map-panel {
      height: 55vh;
      min-height: 360px;
    }

    .viz-inspector-panel {
      height: auto;
      min-height: 0;
      overflow-y: visible;
    }
  }

  .viz-dialog {
    border: none;
    background: transparent;
    padding: 16px;
    max-width: 780px;
    width: calc(100% - 24px);
    margin: auto;
  }

  .viz-dialog::backdrop {
    background: var(--color-backdrop);
    backdrop-filter: blur(4px);
  }

  .viz-dialog-card {
    padding: 28px;
  }

  .viz-dialog-card:hover {
    transform: none;
  }

  .viz-code-block {
    margin-top: 10px;
    background: var(--color-surface-soft);
    padding: 14px 16px;
    border-radius: var(--clay-radius-sm);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--color-text-primary);
    box-shadow: inset 0 2px 6px var(--color-input-shadow);
  }

  :global(.viz-session-btn) {
    text-align: left;
    border: 2px solid transparent;
    border-radius: var(--clay-radius-md);
    padding: 12px 14px;
    background: var(--color-surface-soft);
    color: var(--color-text-primary);
    cursor: pointer;
    box-shadow: var(--clay-shadow-sm);
