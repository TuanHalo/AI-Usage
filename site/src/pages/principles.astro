---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import ClayButton from '../components/ClayButton.astro';

const principles = [
  {
    name: 'progressive-disclosure',
    version: '1.0.0',
    category: 'Architecture & UX',
    description: 'Information should be revealed progressively: show summaries and high-level structure first, enabling users and AI agents to drill down into complex details on demand without token window exhaustion or cognitive overload.',
    applications: [
      'In Skills: Keep SKILL.md concise (<100 lines); place detailed guides in references/ or sub-documents.',
      'In Research Outputs: Always begin with an Executive Summary and high-level findings table before detailed deep-dives.',
      'In Web UIs: Employ collapsible cards, tabs, and interactive drill-downs.'
    ],
    tags: ['principle', 'information-architecture', 'ux', 'token-budget']
  }
];
---

<BaseLayout title="Principles — AI-Usage">
  <div style="margin-bottom: 32px;">
    <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 900; margin-bottom: 8px;">
      💡 Engineering Principles
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-secondary);">
      Foundational tenets governing token budget, design decisions, and agent interaction paradigms.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 32px;">
    {principles.map((pr) => (
      <ClayCard variant="principles">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
          <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
              <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800;">
                {pr.name}
              </h2>
              <ClayBadge>v{pr.version}</ClayBadge>
              <ClayBadge style="background: #ffffff; color: #d97706;">{pr.category}</ClayBadge>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              {pr.tags.map((tag) => (
                <ClayBadge style="background: rgba(255,255,255,0.65); font-size: 0.78rem;">
                  #{tag}
                </ClayBadge>
              ))}
            </div>
          </div>

          <ClayButton href="https://github.com/TuanHalo/AI-Usage/tree/main/assets/principles/progressive-disclosure.yaml">
            Source YAML ➔
          </ClayButton>
        </div>

        <p style="font-size: 1.05rem; margin-bottom: 20px;">
          {pr.description}
        </p>

        <div style="background: rgba(255, 255, 255, 0.7); border-radius: var(--clay-radius-md); padding: 20px;">
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 12px;">
            Practical Applications
          </h3>
          <ul style="margin-left: 20px; display: flex; flex-direction: column; gap: 8px;">
            {pr.applications.map((app) => (
              <li style="color: var(--color-text-secondary);">{app}</li>
            ))}
          </ul>
        </div>
      </ClayCard>
    ))}
  </div>
</BaseLayout>
