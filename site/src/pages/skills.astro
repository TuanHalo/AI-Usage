---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayCard from '../components/ClayCard.astro';
import ClayBadge from '../components/ClayBadge.astro';
import ClayButton from '../components/ClayButton.astro';
import T from '../components/T.astro';
import { SKILLS_VI } from '../i18n/assets-vi';
import skillsData from '../data/skills.json';

interface SkillItem {
  name: string;
  version: string;
  description: string;
  tags: string[];
  targets: string[];
  steps: string[];
}

const skills: SkillItem[] = skillsData;
---

<BaseLayout titleKey="meta.skills.title">
  <div style="margin-bottom: 32px;">
    <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 900; margin-bottom: 8px;">
      <T k="catalog.skills.title" />
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-secondary);">
      <T k="catalog.skills.subtitle" />
    </p>
  </div>

  {skills.length === 0 ? (
    <ClayCard variant="skills" style="text-align: center; padding: 48px 24px;">
      <span style="font-size: 3rem; display: block; margin-bottom: 12px;">🌱</span>
      <h3 style="font-family: var(--font-display); font-size: 1.5rem; margin-bottom: 8px;">
        <T k="catalog.skills.emptyTitle" />
      </h3>
      <p style="color: var(--color-text-secondary); max-width: 520px; margin: 0 auto 24px;">
        <T k="catalog.skills.emptyDesc" html={true} />
      </p>
      <ClayButton href="https://github.com/TuanHalo/AI-Usage">
        <T k="catalog.skills.emptyCta" />
      </ClayButton>
    </ClayCard>
  ) : (
    <div style="display: flex; flex-direction: column; gap: 32px;">
      {skills.map((skill) => {
        const viEntry = SKILLS_VI[skill.name];
        return (
          <ClayCard variant="skills">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
              <div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
                  <h2 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800;">
                    {skill.name}
                  </h2>
                  <ClayBadge>v{skill.version}</ClayBadge>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  {skill.tags.map((tag) => (
                    <ClayBadge style="background: var(--color-surface-soft); font-size: 0.78rem;">
                      #{tag}
                    </ClayBadge>
                  ))}
                </div>
              </div>

              <ClayButton href={`https://github.com/TuanHalo/AI-Usage/tree/main/assets/skills/${skill.name}/skill.yaml`}>
                <T k="catalog.sourceYaml" />
              </ClayButton>
            </div>

            <div style="background: var(--color-surface-soft); border-radius: var(--clay-radius-md); padding: 20px; margin-bottom: 20px;">
              <h4 style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: 6px;">
                <T k="catalog.skills.triggerLabel" />
              </h4>
              <p style="font-size: 1.05rem; color: var(--color-text-primary);">
                <T en={skill.description} vi={viEntry?.descriptionVi ?? skill.description} />
              </p>
            </div>

            <div style="margin-bottom: 20px;">
              <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px;">
                <T k="catalog.skills.procedureLabel" />
              </h3>
              <ol style="margin-left: 24px; display: flex; flex-direction: column; gap: 8px;">
                {skill.steps.map((step, idx) => (
                  <li style="font-size: 1rem; color: var(--color-text-secondary);">
                    <T en={step} vi={viEntry?.itemsVi[idx] ?? step} />
                  </li>
                ))}
              </ol>
            </div>

            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <span style="font-weight: 700; font-size: 0.9rem; color: var(--color-text-secondary);">
                <T k="catalog.skills.targetsLabel" />
              </span>
              {skill.targets.map((tgt) => (
                <ClayBadge style="background: var(--color-surface);">{tgt}</ClayBadge>
              ))}
            </div>
          </ClayCard>
        );
      })}
    </div>
  )}
</BaseLayout>
