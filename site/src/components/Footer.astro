---
import ClayCard from './ClayCard.astro';
import T from './T.astro';
---

<footer style="margin-top: 60px; margin-bottom: 20px;">
  <ClayCard style="text-align: center; background-color: var(--color-surface); padding: 24px;">
    <p style="font-weight: 600; color: var(--color-text-secondary);">
      <T k="footer.tagline" />
    </p>
    <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-top: 6px;">
      <T k="footer.sync" />
    </p>
  </ClayCard>
</footer>
