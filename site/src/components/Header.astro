---
import ClayButton from './ClayButton.astro';
import PreferenceControls from './PreferenceControls.astro';
import T from './T.astro';
import type { TKey } from '../i18n/index';

const navItems: ReadonlyArray<{ readonly labelKey: TKey; readonly href: string }> = [
  { labelKey: 'nav.overview', href: `${import.meta.env.BASE_URL}` },
  { labelKey: 'nav.visualizer', href: `${import.meta.env.BASE_URL}visualizer` },
  { labelKey: 'nav.skills', href: `${import.meta.env.BASE_URL}skills` },
  { labelKey: 'nav.rules', href: `${import.meta.env.BASE_URL}rules` },
  { labelKey: 'nav.agents', href: `${import.meta.env.BASE_URL}agents` },
  { labelKey: 'nav.principles', href: `${import.meta.env.BASE_URL}principles` },
  { labelKey: 'nav.outputs', href: `${import.meta.env.BASE_URL}outputs` },
];
---

<header style="margin-bottom: 40px;">
  <nav class="clay-nav">
    <a href={import.meta.env.BASE_URL} style="display: flex; align-items: center; gap: 10px; font-size: 1.3rem; font-family: var(--font-display); font-weight: 800;">
      <span style="font-size: 1.6rem;">🔮</span>
      <span>AI-Usage</span>
    </a>

    <ul class="clay-nav-links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="clay-nav-link">
            <T k={item.labelKey} />
          </a>
        </li>
      ))}
    </ul>

    <div class="clay-nav-actions">
      <PreferenceControls />
      <ClayButton href="https://github.com/TuanHalo/AI-Usage" class="github-btn">
        ⭐ GitHub
      </ClayButton>
    </div>
  </nav>
</header>
