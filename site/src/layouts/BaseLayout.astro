---
import '../styles/clay.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { translate, type TKey } from '../i18n/index';

interface Props {
  title?: string;
  description?: string;
  titleKey?: TKey;
  descriptionKey?: TKey;
  wide?: boolean;
}

const {
  titleKey = 'meta.home.title',
  descriptionKey = 'meta.home.desc',
  title,
  description,
  wide = false,
} = Astro.props;

const resolvedTitle = title ?? translate('en', titleKey);
const resolvedDescription = description ?? translate('en', descriptionKey);
---

<!DOCTYPE html>
<html
  lang="en"
  data-lang="en"
  data-theme="light"
  data-title-key={title ? undefined : titleKey}
  data-desc-key={description ? undefined : descriptionKey}
>
<head>
  <script is:inline>
    (function () {
      var d = document.documentElement;
      try {
        var s = window.localStorage;
        var t = s ? s.getItem('ai-usage:theme') : null;
        if (t !== 'light' && t !== 'dark') {
          t =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        }
        var q = new URLSearchParams(window.location.search).get('lang');
        if ((q === 'en' || q === 'vi') && s) {
          s.setItem('ai-usage:lang', q);
        }
        var l =
          q === 'en' || q === 'vi'
            ? q
            : s
              ? s.getItem('ai-usage:lang')
              : null;
        if (l !== 'en' && l !== 'vi') {
          l = 'en';
        }
        d.dataset.theme = t;
        d.dataset.lang = l;
        d.lang = l;
      } catch (e) {
        d.dataset.theme = 'light';
        d.dataset.lang = 'en';
        d.lang = 'en';
      }
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <title>{resolvedTitle}</title>
  <meta name="description" content={resolvedDescription} />
  <!-- Google Fonts: Nunito, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
  <div style={`max-width: ${wide ? '100%' : '1180px'}; margin: 0 auto; padding: ${wide ? '20px 28px' : '24px 20px'};`}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </div>
  <script>
    import '../scripts/preferences';
  </script>
</body>
</html>
