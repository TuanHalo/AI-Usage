---
import '../styles/clay.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI-Usage — Universal AI Hub',
  description = 'Canonical AI rules, skills, agents, principles and rich research outputs styled in Claymorphism.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- Google Fonts: Nunito, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
  <div style="max-width: 1180px; margin: 0 auto; padding: 24px 20px;">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </div>
</body>
</html>
